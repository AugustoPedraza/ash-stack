{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["./svelte/*"],
      "$lib": ["./svelte"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "checkJs": true
  },
  "include": ["svelte/**/*.js", "svelte/**/*.svelte"],
  "exclude": ["node_modules"]
}
