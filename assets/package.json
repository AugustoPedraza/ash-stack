{
  "name": "ash-stack-assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "playground": "vite --host --open",
    "lint": "eslint svelte/",
    "lint:fix": "eslint svelte/ --fix",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write \"svelte/**/*.{ts,js,svelte}\"",
    "format:check": "prettier --check \"svelte/**/*.{ts,js,svelte}\""
  },
  "dependencies": {
    "bits-ui": "^2.15.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.10.1",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.0.3",
    "clsx": "^2.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte-check": "^4.3.5",
    "svelte-eslint-parser": "^0.43.0",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^6.0.0"
  }
}
